# Copia este archivo como .env para ejecutar localmente. Nunca subas .env a Git.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
AUTO_MIGRATE=true
# Déjalo vacío para abrir solo la demostración.
DATABASE_URL=
# Para Aiven: URI PostgreSQL del panel + certificado CA completo.
# Usa AIVEN_CA_PATH=./certs/ca.pem localmente o AIVEN_CA_CERT con el contenido PEM.
AIVEN_CA_PATH=
AIVEN_CA_CERT=
# Correo por HTTPS (recomendado para Render Free): remitente de dominio verificado.
RESEND_API_KEY=
MAIL_FROM=
# Alternativa SMTP si tu plan de Render y proveedor lo permiten.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Solo para Flutter Web en un origen diferente. Orígenes exactos, separados por coma.
# En web se recomienda desplegar ambos clientes en el mismo origen por las cookies.
CORS_ORIGINS=
